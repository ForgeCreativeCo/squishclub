rules_version = '2';

// Squish Trade Club — Firestore security rules.
//
// Anyone signed in (every tablet signs in anonymously the moment the app
// opens — see the Firebase bootstrap in index.html) can read and write the
// two collections this app uses:
//
//   players/{playerId}  — one doc per device/kid: name, avatar, coins, inventory
//   trades/{code}       — one doc per open trading table
//
// Why not restrict a player doc to "only its own owner can write it"? Because
// completing a trade has to move items between BOTH players' inventories in
// one atomic step (see maybeExecuteTrade in index.html) — whichever tablet's
// transaction happens to run that step needs to write the OTHER kid's player
// doc too. Firestore has no "but only as part of this specific transaction"
// rule on the free Spark plan — that kind of fine-grained check normally
// lives in a Cloud Function, which needs the paid Blaze plan. Since this is
// a private family app (nobody else has the project's config), "signed in"
// is an acceptable bar for now.
//
// If this app ever gets a wider audience, the next step up is a Cloud
// Function that performs the trade swap server-side, so rules can drop to
// "a player can only ever write their own doc."
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read, write: if request.auth != null;
    }
    match /trades/{code} {
      allow read, write: if request.auth != null;
    }
  }
}
